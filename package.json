{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "seed:prompts": "node --env-file-if-exists=.env scripts/seed-prompts.js",
    "build": "vite build",
    "build:mobile": "vite build --mode native",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@supabase/supabase-js": "^2.78.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.61.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
